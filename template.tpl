___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Enter your template code here.

const log = require('logToConsole');
const injectScript = require('injectScript');
const setInWindow = require('setInWindow');

// 1. Define URLs
const sdkUrl = 'https://cdn.surfside.io/sdk/1.0.0/wave.js?a=' + data.accountId + 
               '&s=' + data.sourceId + 
               '&p=' + data.platform;

const adsUrl = 'https://cdn.surfside.io/ads/2.0.0/r.js';

injectScript(sdkUrl, () => {
  log('Surfside Tracking Script loaded.');

  // 3. ONLY fire Ads script if checkbox is checked
  if (data.SCM === true) {
    log('SCM enabled. Firing Ads 2.0');
    injectScript(adsUrl, () => {
      log('Surfside Ads script loaded.');
      data.gtmOnSuccess();
    }, () => {
      log('Ads script failed to load.');
      data.gtmOnFailure();
    }, 'surfside-ads');
  } else {
    log('SCM disabled. Skipping Ads script.');
    data.gtmOnSuccess();
  }

}, () => {
  log('Main SDK failed to load.');
  data.gtmOnFailure();
}, 'surfside-sdk');

// 1. Check if SCM is enabled AND the menu is dutchie_proxy
if (data.SCM === true && data.menu === 'dutchie_proxy') {
  // 2. Set the global retail overrides
  setInWindow('surfRetailOverrides', {
    accountId: data.accountId,
    siteId: data.sourceId,
    homePage: "886d7",
    shopPage: "886d9",
    cartPage: "886d3"
  }, true);

  // 3. Inject the specific sub-domain renderer
  const rendererUrl = 'https://cdn.surfside.io/ads/2.0.0/renderers/sub-domain.js';
  injectScript(rendererUrl, () => {
    log('Surfside Sub-domain Renderer loaded.');
    data.gtmOnSuccess();
  }, () => {
    log('Renderer failed to load.');
    data.gtmOnFailure();
  }, 'surfside-renderer');

} else {
  // If conditions aren't met, just finish the tag
  log('Conditions for Retail Overrides not met.');
  data.gtmOnSuccess();
}


