// Enter your template code here.

const injectScript = require('injectScript');
const setInWindow = require('setInWindow');
const copyFromWindow = require('copyFromWindow');
const sdkUrl = 'https://cdn.surfside.io/sdk/1.0.0/wave.js?a=' + data.accountId + '&s=' + data.sourceId;
const adsUrl = 'https://cdn.surfside.io/ads/2.0.0/r.js';
const isCityHive = data.SCM === true && data.menu === 'cityhive';

if (!isCityHive) {
  injectScript(sdkUrl, () => {
    if (data.SCM === true) {
      injectScript(adsUrl, () => {
        data.gtmOnSuccess();
      }, () => {
        data.gtmOnFailure();
      }, 'surfside-ads');
    } else {
      data.gtmOnSuccess();
    }

  }, () => {
    data.gtmOnFailure();
  }, 'surfside-sdk');
}

if (data.SCM === true && data.menu === 'dutchie_proxy' && data.menu.adTypeDutchie === 'spa') {
  setInWindow('surfRetailOverrides', {
    accountId: data.accountId,
    siteId: data.sourceId,
    homePage: "886f9",
    shopPage: "k7UbY",
    cartPage: "7TGo1",
    carouselEnabled: true    
  }, true);
  const rendererUrl = 'https://cdn.surfside.io/ads/2.0.0/renderers/sub-domain.js';
  injectScript(rendererUrl, () => {
    data.gtmOnSuccess();
  }, () => {
    data.gtmOnFailure();
  }, 'surfside-renderer');

} else if (data.SCM === true && data.menu === 'dutchie_proxy' && data.menu.adTypeDutchie === 'banners') {
  setInWindow('surfRetailOverrides', {
    accountId: data.accountId,
    siteId: data.sourceId,
    homePage: "886f9",
    shopPage: "k7UbY",
    cartPage: "7TGo1",
  }, true);
  const rendererUrl = 'https://cdn.surfside.io/ads/2.0.0/renderers/sub-domain.js';
  injectScript(rendererUrl, () => {
    data.gtmOnSuccess();
  }, () => {
    data.gtmOnFailure();
  }, 'surfside-renderer');

} else if (data.SCM === true && data.menu === 'iheartjane_proxy') {
    setInWindow('surfsideConfig', {
    accountId: data.accountId,
    siteId: data.sourceId
  }, true);

  const rendererUrl = 'https://cdn.surfside.io/ads/2.0.0/renderers/iheartjane-scm.js';
  injectScript(rendererUrl, () => {
    data.gtmOnSuccess();
  }, () => {
    data.gtmOnFailure();
  }, 'surfside-renderer');

} else if (data.SCM === true && data.menu === 'cityhive') {
  const existingSurf = copyFromWindow('surf');
  if (existingSurf !== undefined && existingSurf !== null) {
    setInWindow('__CITYHIVE_SURF__', existingSurf, true);
    setInWindow('surf', undefined, true);
  }

  setInWindow('surfsideConfig', {
    accountId: data.accountId,
    siteId: data.sourceId
  }, true);

  const cityHiveSdkUrl = 'https://d15ua9w8jchgck.cloudfront.net/sdk/1.0.0/wave.js?a=' + data.accountId + '&s=' + data.sourceId;
  const cityHiveAdsUrl = 'https://d15ua9w8jchgck.cloudfront.net/ads/2.0.0/r.js';
  const cityHiveRendererUrl = 'https://d15ua9w8jchgck.cloudfront.net/ads/2.0.0/renderers/city-hive.js';

  injectScript(cityHiveSdkUrl, () => {
    const surfRef = copyFromWindow('surf');
    setInWindow('SurfSDK', surfRef, true);
    injectScript(cityHiveAdsUrl, () => {
      injectScript(cityHiveRendererUrl, () => {
        data.gtmOnSuccess();
      }, () => {
        data.gtmOnFailure();
      }, 'cityhive-renderer');
    }, () => {
      data.gtmOnFailure();
    }, 'cityhive-ads');
  }, () => {
    data.gtmOnFailure();
  }, 'surfside');

} else {
  data.gtmOnSuccess();
}


